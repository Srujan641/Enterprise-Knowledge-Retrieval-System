# Add at least one key. Priority when several are set: Groq, OpenAI, xAI.
GROQ_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Optional: force a provider (groq, openai, xai) or change a model.
LLM_PROVIDER=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_MODEL=gpt-5-nano
XAI_MODEL=grok-4.3

# Login accounts: username:password:role, comma separated. Roles: general, HR, Admin.
AUTH_USERS=
# Signs login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FAISS_INDEX_PATH=vector_store/faiss_index
DATA_DIR=data
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:5173

# Hard limit on total AI spend, in USD.
LLM_BUDGET_USD=0.50

# Serve interactive API docs at /docs. Leave off outside development.
ENABLE_API_DOCS=false
